<?xml version="1.0" encoding="utf-8"?>
<!-- Applied to the EditText itself so focus is actually felt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/srv_sheet" />
            <stroke
                android:width="2dp"
                android:color="@color/srv_icon_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/srv_field_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/srv_line_strong" />
        </shape>
    </item>
</selector>