<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0F3D0F"
                android:centerColor="#1B5E20"
                android:endColor="#2E6B2F"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#00000000"
                android:endColor="#20C8E6C9"
                android:type="radial"
                android:gradientRadius="600" />
        </shape>
    </item>
</layer-list>