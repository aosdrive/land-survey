<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="REMOVE SURVEY"
            android:textColor="#1B5E20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_accept_parcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Parcel 775" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="This parcel is surveyed but satellite shows no sugarcane there. Its survey will be removed on the server and the parcel goes back to the survey queue. After this you can survey it again from this screen. This is saved on the device now; upload it later from Pending Survey Removals on the home screen."
            android:textColor="#6B8A6B"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_accept_remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Remarks (optional)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:maxLines="4"
            android:minHeight="48dp"
            android:textColor="#1B5E20"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_accept_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/zd_arrow_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:padding="16dp"
            android:text="REMOVE SURVEY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_accept_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:padding="10dp"
            android:text="CANCEL"
            android:textColor="#6B8A6B"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
