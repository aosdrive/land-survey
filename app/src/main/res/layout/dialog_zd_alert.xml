<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable validation dialog. ZdAlert.kt isko inflate karta hai.
     ids: fl_alert_disc, iv_alert_icon, tv_alert_title, tv_alert_message,
          ll_alert_details, tv_alert_details, btn_alert_ok -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/zd_dialog_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- icon disc: rang code se badalta hai (amber / red) -->
    <FrameLayout
        android:id="@+id/fl_alert_disc"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/zd_alert_disc_amber">

        <ImageView
            android:id="@+id/iv_alert_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert_28" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_alert_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Owner Required" />

    <TextView
        android:id="@+id/tv_alert_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#4C7A4C"
        android:textSize="13.5sp"
        tools:text="Please add at least one owner before submitting the survey." />

    <!-- invalid items ki list: sirf zaroorat par visible -->
    <LinearLayout
        android:id="@+id/ll_alert_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/zd_alert_details"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="NEEDS ATTENTION"
            android:textColor="#8CA893"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_alert_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="#1B5E20"
            android:textSize="12.5sp"
            tools:text="Ahmad Ali: 3120-123\nBilal: Empty" />
    </LinearLayout>

    <!-- Slot for list() and custom(): stays gone for plain warn/error/confirm dialogs. -->
    <FrameLayout
        android:id="@+id/fl_alert_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- Actions. Cancel sirf confirm() me visible hota hai. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_alert_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/zd_btn_ghost"
            android:gravity="center"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#2E5A2E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_alert_ok"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:background="@drawable/zd_btn_upload"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="Got it"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>