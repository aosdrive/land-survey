<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_field_gradient"
    android:descendantFocusability="beforeDescendants"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.activities.MenuActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Organic leaf decoration top-right -->
        <ImageView
            android:id="@+id/decoration_leaf_top"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-40dp"
            android:alpha="0.12"
            android:contentDescription="@null"
            android:rotation="25"
            android:src="@drawable/ic_leaf_decoration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Organic leaf decoration bottom-left -->
        <ImageView
            android:id="@+id/decoration_leaf_bottom"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginStart="-60dp"
            android:layout_marginBottom="-60dp"
            android:alpha="0.08"
            android:contentDescription="@null"
            android:rotation="-45"
            android:src="@drawable/ic_leaf_decoration"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- GOVERNMENT BRANDING BAR (same component as login) -->
<!--        <LinearLayout-->
<!--            android:id="@+id/gov_branding_bar"-->
