<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827">

    <com.esri.arcgisruntime.mapping.view.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#8CC540"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#CC212930"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top-right: enter / leave multi-select -->
    <TextView
        android:id="@+id/btnSelectMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/zd_pill_outline"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="SELECT"
        android:textColor="#2E7D32"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Multi-select action bar (shown while selecting parcels) -->
    <HorizontalScrollView
        android:id="@+id/layoutSelectionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E6212930"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/summaryBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="0 selected" />

            <TextView
                android:id="@+id/btnSelAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_arrow_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="REMOVE SURVEY" />

            <TextView
                android:id="@+id/btnSelSurvey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_arrow_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="SURVEY" />

            <TextView
                android:id="@+id/btnSelDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_pill_outline"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="DECLINE" />

            <TextView
                android:id="@+id/btnSelSplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_pill_outline"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="SPLIT" />

            <TextView
                android:id="@+id/btnSelMerge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_pill_outline"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="MERGE" />

            <TextView
                android:id="@+id/btnSelCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_pill_outline"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="CANCEL" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Split controls (shown while drawing the split line) -->
    <LinearLayout
        android:id="@+id/layoutSplitControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E6212930"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/summaryBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSplitHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Tap 2 points across the parcel to draw the split line" />

            <TextView
                android:id="@+id/btnApplySplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_arrow_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="APPLY SPLIT" />

            <TextView
                android:id="@+id/btnCancelSplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/zd_pill_outline"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="CANCEL" />

    </LinearLayout>
    <!-- Neeche summary bar: counts + colour key -->
    <LinearLayout
        android:id="@+id/summaryBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC212930"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#FACC15" />

            <TextView
                android:id="@+id/tvUnmapped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B9C4D0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#EF4444" />

            <TextView
                android:id="@+id/tvNoSurvey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B9C4D0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#F97316" />

            <TextView
                android:id="@+id/tvRemoved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B9C4D0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#22C55E" />

            <TextView
                android:id="@+id/tvAccepted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B9C4D0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#A855F7" />

            <TextView
                android:id="@+id/tvDeclined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B9C4D0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>