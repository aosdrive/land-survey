<?xml version="1.0" encoding="utf-8"?>
<!-- Person entry form. Ab ye BOTTOM SHEET ka content hai (container me add nahi hoti).
     Saare purane ids barqarar hain, plus ek naya: btnSavePerson.
       etFirstName, etLastName, spinnerRelation, etNic, etMobile, etAddress,
       spinnerOwnership, spinnerGender, etGrowerCode,
       etReligion, etExtra1, etExtra2, etMauzaId, etMauzaName, etPersonId, etSurveyId,
       btnRemove, btnSavePerson (naya) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/zd_sheet_bg"
    android:orientation="vertical">

    <!-- drag handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/zd_sheet_handle" />

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/zd_avatar_disc">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_person_20" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="OWNER / LEASEE"
                android:textColor="#8CA893"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:letterSpacing="-0.02"
                android:text="Person Details"
                android:textColor="#1B5E20"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- scrollable body: sheet chhoti screen par bhi kaam kare -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="First Name"
                app:boxBackgroundColor="#F6FAF6"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:boxStrokeErrorColor="#C62828"
                app:errorTextColor="#C62828"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Last Name"
                app:boxBackgroundColor="#F6FAF6"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:boxStrokeErrorColor="#C62828"
                app:errorTextColor="#C62828"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:paddingBottom="6dp"
                android:text="RELATION"
                android:textColor="#6B8A6B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerRelation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/zd_spinner_bg"
                android:dropDownVerticalOffset="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="38dp"
                android:popupBackground="@drawable/zd_dropdown_bg"
                android:spinnerMode="dropdown" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="CNIC  (12345-1234567-1)"
                app:boxBackgroundColor="#F6FAF6"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:boxStrokeErrorColor="#C62828"
                app:errorTextColor="#C62828"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Mobile Number  (923224345678)"
                app:boxBackgroundColor="#F6FAF6"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:boxStrokeErrorColor="#C62828"
                app:errorTextColor="#C62828"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Address"
                app:boxBackgroundColor="#F6FAF6"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:boxStrokeErrorColor="#C62828"
                app:errorTextColor="#C62828"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:paddingBottom="6dp"
                android:text="OWNERSHIP TYPE"
                android:textColor="#6B8A6B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerOwnership"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/zd_spinner_bg"
                android:dropDownVerticalOffset="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="38dp"
                android:popupBackground="@drawable/zd_dropdown_bg"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:paddingBottom="6dp"
                android:text="GENDER"
                android:textColor="#6B8A6B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerGender"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/zd_spinner_bg"
                android:dropDownVerticalOffset="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="38dp"
                android:popupBackground="@drawable/zd_dropdown_bg"
                android:spinnerMode="dropdown" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Grower Code (from list)"
                app:boxBackgroundColor="#EFF3EF"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#C8E6C9"
                app:hintTextColor="#6B8A6B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGrowerCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#4C7A4C"
                    android:textSize="15sp"
                    tools:text="11-01-00001" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hidden fields: code inhe read/write karta hai -->
            <EditText
                android:id="@+id/etReligion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etExtra1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etExtra2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etMauzaId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etMauzaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etPersonId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:visibility="gone"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etSurveyId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:visibility="gone"
                tools:ignore="LabelFor" />
        </LinearLayout>
    </ScrollView>

    <!-- footer actions: sheet ke neeche chipke rahenge -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EFE8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemove"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FDECEA"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="#C62828"
            app:strokeColor="#F3C9C4"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePerson"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1.4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.05"
            android:text="Save Person"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#1B5E20"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check_14"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>