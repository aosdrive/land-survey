        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Property Information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.15"
                        android:text="PROPERTY INFORMATION"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="PROPERTY TYPE"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerPropertyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="PARCEL OWNERSHIP"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerOwnershipStatus"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="CROP"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/etCrop"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="CROP TYPE"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/etCropType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="VARIETY"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/etVariety"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Year"
                    app:boxBackgroundColor="#F6FAF6"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#2E7D32"
                    app:boxStrokeErrorColor="#C62828"
                    app:hintTextColor="#2E7D32">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1B5E20"
                        android:textSize="15sp"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Solar Available -->
<!--                <LinearLayout-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginBottom="16dp"-->
<!--                    android:background="@drawable/zd_check_box"-->
<!--                    android:orientation="vertical">-->

<!--                    <CheckBox-->
<!--                        android:id="@+id/cbGeometryCorrect"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:buttonTint="#2E7D32"-->
<!--                        android:padding="14dp"-->
<!--                        android:text="Solar Available"-->
<!--                        android:textColor="#1B5E20"-->
<!--                        android:textSize="14sp"-->
<!--                        android:textStyle="bold" />-->
<!--                </LinearLayout>-->

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Sowing Date (Optional)"
                    app:boxBackgroundColor="#F6FAF6"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#2E7D32"
                    app:boxStrokeErrorColor="#C62828"
                    app:hintTextColor="#2E7D32">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSowingDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1B5E20"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Remarks (Optional)"
                    app:boxBackgroundColor="#F6FAF6"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#2E7D32"
                    app:boxStrokeErrorColor="#C62828"
                    app:hintTextColor="#2E7D32">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1B5E20"
                        android:textSize="15sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:paddingTop="10dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Owner / Leasee Information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.15"
                        android:text="OWNER / LEASEE INFORMATION"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- weight 1.45: "Select from List" + icon ko poori jagah chahiye,
                         warna text kat jata hai -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectOwner"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1.45"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Select from List"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="#1B5E20"
                        app:cornerRadius="14dp"
                        app:icon="@android:drawable/ic_menu_search"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="17dp"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddNewPerson"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Add New"
                        android:textAllCaps="false"
                        android:textColor="#2E5A2E"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F1F6F1"
                        app:cornerRadius="14dp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="17dp"
                        app:iconTint="#2E5A2E"
                        app:strokeColor="#C8E6C9"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPersonEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Pictures / Documents -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.15"
                        android:text="PICTURES / DOCUMENTS"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:paddingBottom="6dp"
                    android:text="DOCUMENT TYPE"
                    android:textColor="#6B8A6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerImageType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/zd_spinner_bg"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:popupBackground="@drawable/zd_dropdown_bg"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.05"
                    android:text="Capture Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconSize="19dp"
                    app:iconTint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/zd_revisit_chip"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warn_14" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="Wait for all pictures to load completely before submitting. Otherwise, they will not be saved."
                        android:textColor="#8A5B0A"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/zd_media_well"
                    android:minHeight="150dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPictures"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:padding="10dp"
                        android:scrollbars="none"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/zd_dashed_ring">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_gallery"
                                app:tint="#8CB69A" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="No images attached"
                            android:textColor="#4C7A4C"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tap Capture Image to add photos"
                            android:textColor="#8CA893"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutLoadingState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F2FFFFFF"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/progressBarImageLoading"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:indeterminateTint="#2E7D32" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Processing image..."
                            android:textColor="#1B5E20"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Please wait"
                            android:textColor="#8CA893"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Farmer Profile Picture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.15"
                        android:text="FARMER PROFILE PICTURE"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFarmerCapture"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.05"
                    android:text="Capture Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconSize="19dp"
                    app:iconTint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/zd_revisit_chip"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warn_14" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="Wait for the picture to load completely before submitting. Otherwise, it will not be saved."
                        android:textColor="#8A5B0A"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/zd_media_well">

                    <ImageView
                        android:id="@+id/ivFarmerProfileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutFarmerEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/zd_dashed_ring">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_gallery"
                                app:tint="#8CB69A" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="No image attached"
                            android:textColor="#4C7A4C"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Optional - tap Capture Image to add"
                            android:textColor="#8CA893"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSurvey"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.08"
            android:text="Submit Survey"
            android:textAllCaps="false"
            android:textColor="#2E5A2E"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconGravity="textStart"
            app:iconTint="#1B5E20"
            app:strokeWidth="0dp"
            tools:ignore="TextContrastCheck" />

        <!-- Hidden views: code inhe reference karta hai -->
        <EditText
            android:id="@+id/etPropertyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text"
            android:visibility="gone"
            tools:ignore="LabelFor" />

        <Button
            android:id="@+id/btnAddImage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>