<?xml version="1.0" encoding="utf-8"?>
<!-- Downloaded area row. Root stays a LinearLayout so the adapter's
     ViewHolder(itemView) and findViewById calls keep working. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/zd_row_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp">

    <!-- selection -->
    <RadioButton
        android:id="@+id/radioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:buttonTint="#2E7D32"
        tools:checked="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- mauza -->
        <TextView
            android:id="@+id/mauzaNameCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="MAUZA"
            android:textColor="#8CA893"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mauzaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="#1B5E20"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Chak 42 JB" />

        <!-- area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/areaNameCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="AREA"
                android:textColor="#8CA893"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/areaName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#4C7A4C"
                android:textSize="13sp"
                tools:text="Block A" />
        </LinearLayout>
    </LinearLayout>

    <!-- delete: 44dp target, was a bare ic_delete before -->
    <ImageButton
        android:id="@+id/imageButtonDelete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/zd_icon_btn_bg"
        android:contentDescription="Delete"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_delete_24" />
</LinearLayout>